# ==============================================================================
# HunarLink Hardened Nginx Reverse Proxy — EXAMPLE ONLY
# ==============================================================================
# Replace `api.hunarlink.example` and TLS cert paths with your staging/prod values.
# Preserves exact unmodified raw request bytes on `/api/v1/webhooks/razorpay`
# so HMAC SHA-256 signature verification never breaks!

limit_req_zone $binary_remote_addr zone=hl_api_general:10m rate=30r/s;
limit_req_zone $binary_remote_addr zone=hl_payments:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=hl_uploads:10m rate=6r/m;
limit_req_zone $binary_remote_addr zone=hl_chatbot:10m rate=20r/m;

server {
    listen 80;
    listen [::]:80;
    server_name api.hunarlink.example;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.hunarlink.example;

    server_tokens off;

    # TLS 1.2 & 1.3 only (modern ciphers)
    ssl_certificate     /etc/letsencrypt/live/api.hunarlink.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.hunarlink.example/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache   shared:SSL:10m;

    # Defensive HTTP Security Headers
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # Tight global payload ceiling (overridden only on controlled document upload route)
    client_max_body_size 1m;
    client_body_timeout 15s;
    client_header_timeout 15s;

    # 1. Razorpay Signed Webhooks (raw body preserved verbatim!)
    location = /api/v1/webhooks/razorpay {
        client_max_body_size 512k;
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_request_buffering on;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 2. Payment Checkout & Verification (strict rate limit)
    location ^~ /api/v1/payments/ {
        limit_req zone=hl_payments burst=10 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 3. Private Document Uploads (10 MB cap aligned with backend MAX_UPLOAD_SIZE_BYTES)
    location = /api/v1/guardrails/documents/upload {
        limit_req zone=hl_uploads burst=5 nodelay;
        client_max_body_size 10m;
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 4. HunarSathi Chatbot SSE Streaming Endpoint
    location ^~ /chatbot/ {
        limit_req zone=hl_chatbot burst=10 nodelay;
        proxy_pass http://127.0.0.1:5050/;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 30s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 5. General HunarLink FastAPI API
    location / {
        limit_req zone=hl_api_general burst=40 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
