# Copy this file to app/.env.local for local development.
# NEVER put RAZORPAY_KEY_SECRET, RAZORPAY_WEBHOOK_SECRET, CLERK_SECRET_KEY,
# or database passwords in VITE_* variables — everything in VITE_* is public!

# Optional: Clerk Publishable Key (https://dashboard.clerk.com -> API Keys)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Optional: HunarLink FastAPI Backend base URL (e.g. https://api.hunarlink.example)
# In Vite dev mode (`npm run dev`), `/api`, `/healthz`, and `/readyz` are automatically
# proxied to VITE_API_PROXY_TARGET (default http://127.0.0.1:8000).
# In static production builds (e.g. GitHub Pages), leave both unset for zero-error Static Preview Mode.
VITE_API_BASE_URL=
# Set to `true` only when serving the production SPA behind a same-origin reverse proxy (e.g. Nginx)
# that routes `/api`, `/healthz`, and `/readyz` to FastAPI:
VITE_ENABLE_SAME_ORIGIN_API=
# Optional Vite dev proxy target (dev server only; default http://127.0.0.1:8000):
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Optional: HunarSathi Chatbot API base URL (e.g. http://localhost:5050)
VITE_HUNARSATHI_API_URL=
