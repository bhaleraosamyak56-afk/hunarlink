# HunarLink MySQL 8.4 LTS Database Connection Example
# Copy to .env (gitignored) and replace placeholders with real local/staging secrets.
# NEVER commit a real .env file.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=hunarlink
MYSQL_USER=hunarlink_app
MYSQL_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
MYSQL_CHARSET=utf8mb4

# SQLAlchemy 2.x synchronous MySQL URL (use URL.create() in Python if password has special chars)
DATABASE_URL=mysql+pymysql://hunarlink_app:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:3306/hunarlink?charset=utf8mb4
